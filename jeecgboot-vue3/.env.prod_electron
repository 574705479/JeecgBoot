# 是否启用mock
VITE_USE_MOCK = false

# 授权系统地址（固定配置，打包时唯一需要修改的变量）
VITE_GLOB_LICENSE_URL=https://sq.beartalk.net

# 以下两项由 Electron 运行时通过授权系统动态获取，打包时留空
VITE_GLOB_API_URL=
VITE_GLOB_DOMAIN_URL=

# 接口父路径前缀
VITE_GLOB_API_URL_PREFIX=/jeecgboot

# 在线文档编辑版本。可选属性：wps, offlineWps(离线版), onlyoffice
VITE_GLOB_ONLINE_DOCUMENT_VERSION=wps

# 客服加解密（与客户实际连线的后端 jeecg.cs.crypto 一致；连生产则与 application-prod.yml 一致）
