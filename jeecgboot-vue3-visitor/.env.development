# 访客端开发环境
# 后台接口完整地址（与主项目保持一致；通过 vite proxy 转发）
VITE_GLOB_DOMAIN_URL=http://localhost:8080/jeecg-boot
VITE_GLOB_API_URL=/jeecgboot
VITE_GLOB_API_URL_PREFIX=

# 跨域代理（与主项目同源）
VITE_PROXY=[["/jeecgboot","http://localhost:8080/jeecg-boot"]]

# 客服加解密（必须与后端 application-dev.yml jeecg.cs.crypto 完全一致；与主项目共用）
VITE_CS_STORAGE_KEY=PKHX8dfuePB2PpT4
VITE_CS_STORAGE_IV=7JBzAcDRQc9HCahm
VITE_CS_TRANSPORT_KEY=Cdg9VObOpE3yEQzz
VITE_CS_TRANSPORT_IV=frYwJYzoqXvv5ePy
