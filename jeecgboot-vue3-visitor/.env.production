# 访客端生产环境
# Public path 强制为 /visitor/，与主项目 nginx 路由 `/cs/userChat -> /visitor/index.html` 配套
VITE_PUBLIC_PATH=/visitor/

# 后台接口父地址（必填；nginx 反代到后端 jeecg-boot）
VITE_GLOB_DOMAIN_URL=/jeecgboot
VITE_GLOB_API_URL=/jeecgboot
VITE_GLOB_API_URL_PREFIX=

# 客服加解密（必须与后端 application-prod.yml 中 jeecg.cs.crypto 完全一致；与主项目共用）
VITE_CS_STORAGE_KEY=K9mP2xQ7nR4vW8sL
VITE_CS_STORAGE_IV=T3yB6cF1hJ0kN5zX
VITE_CS_TRANSPORT_KEY=Z4aS8dG2fH7jM1qW
VITE_CS_TRANSPORT_IV=E5rT9vY3uI6oP0xC

# 启用 gzip 压缩
VITE_BUILD_COMPRESS=gzip
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE=false
